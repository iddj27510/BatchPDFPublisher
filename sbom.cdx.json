  "properties": [
    {
      "value": "[{\"category\":\"transitive\",\"description\":\"Inventor API transitive COM components are not enumerated. The RxInventor.tlb type library is a facade over a large set of Autodesk COM servers whose specific versions are determined at runtime by the Inventor installation.\"},{\"category\":\"runtime-resolved\",\"description\":\"PDF Translator AddIn GUID is not resolved at build time. The AddIn is discovered at runtime via ApplicationAddIns.ItemById(PDF_GUID) with enumeration fallback (see modPDFFileIO.PDF_FindAddIn).\"},{\"category\":\"platform-native\",\"description\":\"Windows COM components (Scripting.FileSystemObject, Scripting.Dictionary, System.Collections.ArrayList, ADODB.Stream, Shell.Application, htmlfile, OLE DataObject, WScript.Shell) are provided by the OS. Their versions track Windows Update and are outside SBOM scope.\"}]",
